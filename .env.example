# ===== LLM 配置（必填其一，OpenAI 兼容协议）=====
# DeepSeek（默认）：https://platform.deepseek.com 申请
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 智谱示例（改用下面三行时注释掉上面三行）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxxxxxxx.xxxxxxxx
# LLM_MODEL=glm-4.6

# ===== 数据源（可选，一般不用改）=====
# K线/行情源顺序：binance(公开镜像) 或 okx
# KLINE_SOURCES=binance,okx
# 衍生品源顺序：okx 或 bybit
# DERIV_SOURCES=okx,bybit
# CryptoPanic 免费 token（可选，不填则用 Cointelegraph RSS）
# CRYPTOPANIC_TOKEN=
